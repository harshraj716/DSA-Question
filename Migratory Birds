#include <iostream>
#include <vector>
using namespace std;

int migratoryBirds(vector<int> arr) {
    // IDs are from 1 to 5, so index 0 is unused
    vector<int> freq(6, 0);

    // Count frequency of each bird type
    for (int id : arr) {
        freq[id]++;
    }

    int maxCount = 0;
    int birdType = 1;

    for (int i = 1; i <= 5; i++) {
        if (freq[i] > maxCount) {
            maxCount = freq[i];
            birdType = i;
        }
    }

    return birdType;
}

int main() {
    int n;
    cin >> n;

    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << migratoryBirds(arr) << endl;
    return 0;
}
