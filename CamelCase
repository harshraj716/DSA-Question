#include <iostream>
#include <string>
using namespace std;

int camelcase(const string& s) {
    int wordCount = 1;  // Start with 1 because the first word is all lowercase
    for (char ch : s) {
        if (isupper(ch)) {
            wordCount++;
        }
    }
    return wordCount;
}

int main() {
    string s;
    cin >> s;

    int result = camelcase(s);
    cout << result << endl;

    return 0;
}
