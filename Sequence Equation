#include <iostream>
#include <vector>
using namespace std;

vector<int> permutationEquation(vector<int> p) {
    int n = p.size();
    vector<int> result(n);

    for (int x = 1; x <= n; x++) {
        // First, find i such that p[i] == x
        int first = 0;
        for (int i = 0; i < n; i++) {
            if (p[i] == x) {
                first = i + 1; // 1-based index
                break;
            }
        }

        // Then, find j such that p[j] == first
        for (int j = 0; j < n; j++) {
            if (p[j] == first) {
                result[x - 1] = j + 1; // Store result for current x
                break;
            }
        }
    }

    return result;
}

int main() {
    int n;
    cin >> n;

    vector<int> p(n);
    for (int i = 0; i < n; i++) {
        cin >> p[i];
    }

    vector<int> result = permutationEquation(p);
    for (int val : result) {
        cout << val << endl;
    }

    return 0;
}
