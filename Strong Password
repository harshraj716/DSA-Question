#include <iostream>
#include <string>
using namespace std;

int minimumNumber(int n, string password) {
    bool hasDigit = false, hasLower = false, hasUpper = false, hasSpecial = false;
    string specialCharacters = "!@#$%^&*()-+";

    // Check if the password already contains the required characters
    for (int i = 0; i < n; i++) {
        if (isdigit(password[i])) hasDigit = true;
        if (islower(password[i])) hasLower = true;
        if (isupper(password[i])) hasUpper = true;
        if (specialCharacters.find(password[i]) != string::npos) hasSpecial = true;
    }

    // Count how many types of characters are missing
    int missingTypes = 0;
    if (!hasDigit) missingTypes++;
    if (!hasLower) missingTypes++;
    if (!hasUpper) missingTypes++;
    if (!hasSpecial) missingTypes++;

    // Ensure the password is at least 6 characters long
    return max(missingTypes, 6 - n); 
}

int main() {
    int n;
    string password;
    cin >> n >> password;

    // Output the result (minimum characters to add)
    cout << minimumNumber(n, password) << endl;

    return 0;
}
