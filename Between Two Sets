#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

int getTotalX(vector<int>& a, vector<int>& b) {
    // Step 1: Find the maximum of array a and the minimum of array b
    int max_a = *max_element(a.begin(), a.end());
    int min_b = *min_element(b.begin(), b.end());

    int count = 0;

    // Step 2: Check multiples of max_a up to min_b
    for (int x = max_a; x <= min_b; x += max_a) {
        // Check if x is a factor of all elements in b
        bool isFactorOfB = true;
        for (int i = 0; i < b.size(); ++i) {
            if (b[i] % x != 0) {
                isFactorOfB = false;
                break;
            }
        }

        // Check if all elements in a are factors of x
        bool isFactorOfA = true;
        for (int i = 0; i < a.size(); ++i) {
            if (x % a[i] != 0) {
                isFactorOfA = false;
                break;
            }
        }

        // If x satisfies both conditions, count it
        if (isFactorOfB && isFactorOfA) {
            count++;
        }
    }

    return count;
}

int main() {
    int n, m;
    cin >> n >> m;

    vector<int> a(n);
    vector<int> b(m);

    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    for (int i = 0; i < m; ++i) {
        cin >> b[i];
    }

    cout << getTotalX(a, b) << endl;

    return 0;
}

