#include <iostream>
#include <vector>
#include <algorithm>
#include <cmath>
#include <climits>  // Include this for INT_MAX
using namespace std;

int minimumAbsoluteDifference(vector<int>& arr) {
    sort(arr.begin(), arr.end()); // Sort the array to make comparisons easier
    int minDiff = INT_MAX; // Initialize the minimum difference to a very large value

    // Use size_t instead of int to match the return type of arr.size()
    for (size_t i = 1; i < arr.size(); i++) {
        minDiff = min(minDiff, abs(arr[i] - arr[i - 1]));
    }

    return minDiff; // Return the minimum absolute difference
}

int main() {
    int n;
    cin >> n; // Input the size of the array
    vector<int> arr(n); // Declare the array
    for (int i = 0; i < n; i++) {
        cin >> arr[i]; // Input each element in the array
    }

    // Output the result (minimum absolute difference)
    cout << minimumAbsoluteDifference(arr) << endl;

    return 0;
}
